rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['rahulbasak498@gmail.com', 'Rahulbasak498@gmail.com'];
    }

    // Visitor wishes are public as soon as they are submitted.
    match /wishes/{wishId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'loc', 'msg', 'approved', 'createdAt'])
                    && wishId.matches('^[A-Za-z0-9_-]{1,128}$')
                    && request.resource.data.approved == true
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.loc is string
                    && request.resource.data.loc.size() <= 60
                    && request.resource.data.msg is string
                    && request.resource.data.msg.size() > 0
                    && request.resource.data.msg.size() <= 300
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /notificationSubscriptions/{subscriptionId} {
      allow create, update: if request.resource.data.keys().hasOnly(['token', 'createdAt'])
                    && request.resource.data.token is string
                    && request.resource.data.token.size() > 100
                    && request.resource.data.token.size() <= 4096
                    && request.resource.data.createdAt == request.time
                    && (!exists(/databases/$(database)/documents/notificationSubscriptions/$(subscriptionId))
                      || resource.data.token == request.resource.data.token);
      allow read, delete: if isAdmin();
    }

    match /{collection}/{docId} {
      allow read: if isAdmin() || collection in [
        'siteSettings', 'notices', 'schedule', 'members', 'ticker',
        'gallery', 'affiliates', 'events', 'about', 'pageHeadings'
      ];
      allow write: if isAdmin()
                   && collection != 'wishes'
                   && collection != 'notificationSubscriptions';
    }
  }
}
